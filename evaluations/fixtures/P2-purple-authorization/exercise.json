      "description": "Encoded benign PowerShell command",
      "targetHost": "prd-win-03",
      "expected": {
        "telemetrySources": [
          "ps-scriptblock-4104"
        ],
        "detections": [
          "SIEM-PS-ENCODED"
        ],
        "maxLatencySeconds": 300
      }
    },
    {
      "id": "S5",
      "technique": {
        "id": "T1053.005",
        "name": "Scheduled Task/Job: Scheduled Task"
      },
      "description": "Create and delete benign scheduled task",
