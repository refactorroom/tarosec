        "detections": [
          "EDR-CRED-LSASS-ACCESS"
        ],
        "maxLatencySeconds": 300
      }
    },
    {
      "id": "S2",
      "technique": {
        "id": "T1087.002",
        "name": "Account Discovery: Domain Account"
      },
      "description": "net group \"Domain Admins\" /domain from synthetic user",
      "targetHost": "prd-win-02",
      "expected": {
        "telemetrySources": [
          "edr-process"
        ],
        "detections": [
          "SIEM-DISC-DOMAIN-ADMINS"
        ],
        "maxLatencySeconds": 600
      }
    },
    {
      "id": "S3",
      "technique": {
        "id": "T1558.003",
        "name": "Steal or Forge Kerberos Tickets: Kerberoasting"
      },
      "description": "Request TGS for synthetic SPN svc-lab-sql",
