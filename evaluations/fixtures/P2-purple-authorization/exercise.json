      "expected": {
        "telemetrySources": [
          "dc-security-4769"
        ],
        "detections": [
          "SIEM-KERB-RC4-TGS"
        ],
        "maxLatencySeconds": 600
      }
    },
    {
      "id": "S4",
      "technique": {
        "id": "T1059.001",
        "name": "Command and Scripting Interpreter: PowerShell"
